---

---

<!-- Sin background, flota en el canvas global -->
<section id="features" class="relative py-24 sm:py-32 w-full">
    <!-- Línea decorativa vertical que conecta con el Hero -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[1px] h-24 bg-gradient-to-b from-transparent to-primary/10"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 mt-12">
        <div class="mx-auto max-w-2xl text-center" data-aos="fade-up">
            <span
                class="block text-xs font-semibold tracking-[0.2em] uppercase text-primary-vibrant"
            >
                Beneficios
            </span>
            <h2 class="mt-6 text-3xl font-medium tracking-tight sm:text-5xl">
                Todo lo que tu equipo necesita para operar seguro
            </h2>
            <p class="mt-8 text-lg leading-relaxed text-primary/60 font-light">
                Verificá cheques antes de aceptarlos con datos oficiales del
                BCRA y ARCA. Resultados en segundos, historial compartido
                para todo tu equipo.
            </p>
        </div>

        <div class="mx-auto mt-24 max-w-2xl sm:mt-32 lg:max-w-none">
            <dl
                class="grid max-w-xl grid-cols-1 gap-x-16 gap-y-24 lg:max-w-none lg:grid-cols-4 m-auto"
            >
                <!-- Feature 1 -->
                <div
                    class="flex flex-col items-center justify-center text-center group"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <dt class="flex flex-col items-center">
                        <div
                            class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-primary-vibrant/15 text-primary-vibrant transition-all duration-500 group-hover:border-accent-brand group-hover:text-accent-brand group-hover:shadow-[0_0_25px_-5px_rgba(32,181,130,0.45)] bg-primary-vibrant/5"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-xl font-medium tracking-tight group-hover:text-primary-vibrant transition-colors duration-300"
                        >
                            Datos que no fallan
                        </h3>
                    </dt>
                    <dd
                        class="mt-4 flex flex-auto flex-col text-sm leading-relaxed text-primary/50 font-light"
                    >
                        <p class="flex-auto">
                            Cada análisis cruza la Central de Deudores, cheques
                            rechazados del BCRA y el padrón de ARCA. Datos
                            oficiales, no estimaciones.
                        </p>
                    </dd>
                </div>

                <!-- Feature 2 -->
                <div
                    class="flex flex-col items-center justify-center text-center group relative"
                    data-aos="fade-up"
                    data-aos-delay="200"
                >
                    <!-- Línea separadora horizontal md+ -->
                    <div
                        class="hidden lg:block absolute top-[2rem] -left-16 w-16 h-[1px] bg-primary/5"
                    >
                    </div>
                    <dt class="flex flex-col items-center">
                        <div
                            class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-primary-vibrant/15 text-primary-vibrant transition-all duration-500 group-hover:border-accent-brand group-hover:text-accent-brand group-hover:shadow-[0_0_25px_-5px_rgba(32,181,130,0.45)] bg-primary-vibrant/5"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-xl font-medium tracking-tight group-hover:text-primary-vibrant transition-colors duration-300"
                        >
                            Detectá riesgo antes de aceptar
                        </h3>
                    </dt>
                    <dd
                        class="mt-4 flex flex-auto flex-col text-sm leading-relaxed text-primary/50 font-light"
                    >
                        <p class="flex-auto">
                            Cheques rechazados, inhabilitaciones y deuda en la
                            Central de Deudores. Lo sabés antes de aceptar
                            el valor.
                        </p>
                    </dd>
                </div>

                <!-- Feature 3 -->
                <div
                    class="flex flex-col items-center justify-center text-center group relative"
                    data-aos="fade-up"
                    data-aos-delay="300"
                >
                    <!-- Línea separadora horizontal md+ -->
                    <div
                        class="hidden lg:block absolute top-[2rem] -left-16 w-16 h-[1px] bg-primary/5"
                    >
                    </div>
                    <dt class="flex flex-col items-center">
                        <div
                            class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-primary-vibrant/15 text-primary-vibrant transition-all duration-500 group-hover:border-accent-brand group-hover:text-accent-brand group-hover:shadow-[0_0_25px_-5px_rgba(32,181,130,0.45)] bg-primary-vibrant/5"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-xl font-medium tracking-tight group-hover:text-primary-vibrant transition-colors duration-300"
                        >
                            Historial compartido para tu equipo
                        </h3>
                    </dt>
                    <dd
                        class="mt-4 flex flex-auto flex-col text-sm leading-relaxed text-primary/50 font-light"
                    >
                        <p class="flex-auto">
                            Cada análisis queda registrado. Tu equipo accede al
                            mismo historial y toma decisiones con la misma
                            información.
                        </p>
                    </dd>
                </div>

                <!-- Feature 4 -->
                <div
                    class="flex flex-col items-center justify-center text-center group relative"
                    data-aos="fade-up"
                    data-aos-delay="400"
                >
                    <!-- Línea separadora horizontal md+ -->
                    <div
                        class="hidden lg:block absolute top-[2rem] -left-16 w-16 h-[1px] bg-primary/5"
                    >
                    </div>
                    <dt class="flex flex-col items-center">
                        <div
                            class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-primary-vibrant/15 text-primary-vibrant transition-all duration-500 group-hover:border-accent-brand group-hover:text-accent-brand group-hover:shadow-[0_0_25px_-5px_rgba(32,181,130,0.45)] bg-primary-vibrant/5"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-xl font-medium tracking-tight group-hover:text-primary-vibrant transition-colors duration-300"
                        >
                            Foto, CUIT o eCheq: como quieras
                        </h3>
                    </dt>
                    <dd
                        class="mt-4 flex flex-auto flex-col text-sm leading-relaxed text-primary/50 font-light"
                    >
                        <p class="flex-auto">
                            Escaneá con la cámara, ingresá un CUIT o subí un
                            eCheq. En segundos tenés el resultado.
                        </p>
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</section>
