<section class="w-full bg-primary/[0.02] border-y border-primary/5 py-6 sm:py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-center items-center gap-8 sm:gap-12 lg:gap-16">
      
      <!-- Badge 1 -->
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-accent-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
        </svg>
        <span class="text-sm font-medium tracking-wide text-primary/50">Datos oficiales del Banco Central</span>
      </div>

      <!-- Badge 2 -->
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-accent-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M12 3c0 0-4.5 1.5-9 1.5v6.75c0 4.35 3.65 8.1 9 10.5 5.35-2.4 9-6.15 9-10.5V4.5C16.5 4.5 12 3 12 3z" />
        </svg>
        <span class="text-sm font-medium tracking-wide text-primary/50">Conexión directa con ARCA</span>
      </div>

      <!-- Badge 3 -->
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-accent-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
        </svg>
        <span class="text-sm font-medium tracking-wide text-primary/50">Análisis en tiempo real</span>
      </div>

    </div>
  </div>
</section>
