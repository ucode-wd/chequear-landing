---
---

<section id="pricing" class="relative py-24 sm:py-32 w-full">
    <!-- Decorative vertical line -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1px] h-24 bg-gradient-to-b from-primary/10 to-transparent"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 mt-12">
        <div class="mx-auto max-w-2xl text-center" data-aos="fade-up">
            <span class="block text-xs font-semibold tracking-[0.2em] uppercase text-primary-vibrant">
                PLANES Y SOLUCIONES
            </span>
            <h2 class="mt-6 text-3xl font-medium tracking-tight sm:text-5xl text-primary">
                Elegí el plan que necesita tu empresa
            </h2>
            <p class="mt-8 text-lg leading-relaxed text-primary/60 font-light">
                <span class="ab-only-a">Suscripción mensual con créditos renovables. Sin contratos anuales, cancelá cuando quieras.</span>
                <span class="ab-only-b">Planes adaptados al volumen operativo de tu organización. Facturación mensual y soporte dedicado.</span>
            </p>
        </div>

        <!-- Enterprise Plans Grid: 4 Core Columns -->
        <div class="mt-16 sm:mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-6 xl:gap-8">
            
            <!-- Card 1: Profesional -->
            <div class="rounded-3xl border border-primary/10 bg-white/70 backdrop-blur-sm p-8 hover:shadow-xl hover:border-primary/25 transition-all duration-300 flex flex-col justify-between group" data-aos="fade-up" data-aos-delay="0">
                <div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-xl font-bold text-primary tracking-tight">Profesional</h3>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-primary/5 text-primary/60">Packs 100</span>
                    </div>
                    <p class="text-sm text-primary/50 font-light mt-2">100 análisis por mes</p>
                    
                    <!-- Variant A: With Price -->
                    <div class="ab-only-a mt-6">
                        <span class="text-4xl font-extrabold text-primary tracking-tight">$38.000</span>
                        <span class="text-sm font-normal text-primary/40">/mes</span>
                        <p class="text-xs font-medium text-accent mt-1">$380 por cheque verificado</p>
                    </div>

                    <!-- Variant B: Without Price -->
                    <div class="ab-only-b mt-6">
                        <span class="text-2xl font-bold text-primary tracking-tight">A cotizar</span>
                        <p class="text-xs font-medium text-accent mt-1">Tarifa corporativa preferencial</p>
                    </div>
                    
                    <ul class="mt-8 space-y-3.5 border-t border-primary/5 pt-6">
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Múltiples usuarios de equipo
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Facturación institucional (A/B)
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Historial unificado de consultas
                        </li>
                    </ul>
                </div>
                <a href="#contacto" data-plan="Profesional" data-plan-capacity="100" class="plan-trigger-btn mt-8 flex h-12 items-center justify-center rounded-full border border-primary-vibrant/30 px-6 text-sm font-semibold text-primary-vibrant hover:bg-primary-vibrant/5 hover:border-primary-vibrant/60 transition-all duration-300 w-full">
                    <span class="ab-only-a">Solicitar Plan</span>
                    <span class="ab-only-b">Solicitar Cotización</span>
                </a>
            </div>

            <!-- Card 2: PyME (HIGHLIGHTED) -->
            <div class="relative rounded-3xl border-2 border-accent-brand bg-white shadow-[0_12px_45px_-10px_rgba(32,181,130,0.22)] lg:scale-[1.03] p-8 flex flex-col justify-between group z-10" data-aos="fade-up" data-aos-delay="100">
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 px-4 py-1 rounded-full bg-accent-brand text-white text-xs font-bold tracking-wider uppercase shadow-sm">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    Más elegido
                </span>
                <div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-xl font-bold text-primary tracking-tight">PyME</h3>
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-accent-brand/10 text-accent">Packs 250</span>
                    </div>
                    <p class="text-sm text-primary/60 font-light mt-2">250 análisis por mes</p>
                    
                    <!-- Variant A: With Price -->
                    <div class="ab-only-a mt-6">
                        <span class="text-4xl font-extrabold text-primary tracking-tight">$90.000</span>
                        <span class="text-sm font-normal text-primary/40">/mes</span>
                        <p class="text-xs font-medium text-accent mt-1">$360 por cheque verificado</p>
                    </div>

                    <!-- Variant B: Without Price -->
                    <div class="ab-only-b mt-6">
                        <span class="text-2xl font-bold text-primary tracking-tight">A cotizar</span>
                        <p class="text-xs font-medium text-accent mt-1">Tarifa corporativa preferencial</p>
                    </div>
                    
                    <ul class="mt-8 space-y-3.5 border-t border-primary/5 pt-6">
                        <li class="flex items-center gap-2.5 text-sm text-primary/80 font-medium">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Múltiples usuarios de equipo
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/80 font-medium">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Facturación institucional (A/B)
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/80 font-medium">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Historial unificado de consultas
                        </li>
                    </ul>
                </div>
                <a href="#contacto" data-plan="PyME" data-plan-capacity="250" class="plan-trigger-btn mt-8 flex h-12 w-full items-center justify-center rounded-full bg-primary-vibrant px-6 text-sm font-semibold text-white shadow-[0_4px_20px_-4px_rgba(25,44,95,0.45)] hover:shadow-[0_8px_30px_-4px_rgba(25,44,95,0.55)] hover:bg-primary-vibrant/90 transition-all duration-300 animate-shimmer" style="background-image: linear-gradient(110deg, #192C5F 40%, #2a4585 50%, #192C5F 60%);">
                    <span class="ab-only-a">Solicitar Plan</span>
                    <span class="ab-only-b">Solicitar Cotización</span>
                </a>
            </div>

            <!-- Card 3: Empresarial -->
            <div class="rounded-3xl border border-primary/10 bg-white/70 backdrop-blur-sm p-8 hover:shadow-xl hover:border-primary/25 transition-all duration-300 flex flex-col justify-between group" data-aos="fade-up" data-aos-delay="200">
                <div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-xl font-bold text-primary tracking-tight">Empresarial</h3>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-primary/5 text-primary/60">Packs 500</span>
                    </div>
                    <p class="text-sm text-primary/50 font-light mt-2">500 análisis por mes</p>
                    
                    <!-- Variant A: With Price -->
                    <div class="ab-only-a mt-6">
                        <span class="text-4xl font-extrabold text-primary tracking-tight">$170.000</span>
                        <span class="text-sm font-normal text-primary/40">/mes</span>
                        <p class="text-xs font-medium text-accent mt-1">$340 por cheque verificado</p>
                    </div>

                    <!-- Variant B: Without Price -->
                    <div class="ab-only-b mt-6">
                        <span class="text-2xl font-bold text-primary tracking-tight">A cotizar</span>
                        <p class="text-xs font-medium text-accent mt-1">Tarifa corporativa preferencial</p>
                    </div>
                    
                    <ul class="mt-8 space-y-3.5 border-t border-primary/5 pt-6">
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Múltiples usuarios de equipo
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Facturación institucional (A/B)
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Historial unificado de consultas
                        </li>
                    </ul>
                </div>
                <a href="#contacto" data-plan="Empresarial" data-plan-capacity="500" class="plan-trigger-btn mt-8 flex h-12 items-center justify-center rounded-full border border-primary-vibrant/30 px-6 text-sm font-semibold text-primary-vibrant hover:bg-primary-vibrant/5 hover:border-primary-vibrant/60 transition-all duration-300 w-full">
                    <span class="ab-only-a">Solicitar Plan</span>
                    <span class="ab-only-b">Solicitar Cotización</span>
                </a>
            </div>

            <!-- Card 4: Corporativo -->
            <div class="rounded-3xl border border-primary/10 bg-white/70 backdrop-blur-sm p-8 hover:shadow-xl hover:border-primary/25 transition-all duration-300 flex flex-col justify-between group" data-aos="fade-up" data-aos-delay="300">
                <div>
                    <div class="flex items-center justify-between">
                        <h3 class="text-xl font-bold text-primary tracking-tight">Corporativo</h3>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-primary/5 text-primary/60">Packs 1.000</span>
                    </div>
                    <p class="text-sm text-primary/50 font-light mt-2">1.000 análisis por mes</p>
                    
                    <!-- Variant A: With Price -->
                    <div class="ab-only-a mt-6">
                        <span class="text-4xl font-extrabold text-primary tracking-tight">$310.000</span>
                        <span class="text-sm font-normal text-primary/40">/mes</span>
                        <p class="text-xs font-medium text-accent mt-1">$310 por cheque verificado</p>
                    </div>

                    <!-- Variant B: Without Price -->
                    <div class="ab-only-b mt-6">
                        <span class="text-2xl font-bold text-primary tracking-tight">A cotizar</span>
                        <p class="text-xs font-medium text-accent mt-1">Tarifa corporativa preferencial</p>
                    </div>
                    
                    <ul class="mt-8 space-y-3.5 border-t border-primary/5 pt-6">
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Múltiples usuarios de equipo
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Facturación institucional (A/B)
                        </li>
                        <li class="flex items-center gap-2.5 text-sm text-primary/70 font-light">
                            <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                            Historial unificado de consultas
                        </li>
                    </ul>
                </div>
                <a href="#contacto" data-plan="Corporativo" data-plan-capacity="1000" class="plan-trigger-btn mt-8 flex h-12 items-center justify-center rounded-full border border-primary-vibrant/30 px-6 text-sm font-semibold text-primary-vibrant hover:bg-primary-vibrant/5 hover:border-primary-vibrant/60 transition-all duration-300 w-full">
                    <span class="ab-only-a">Solicitar Plan</span>
                    <span class="ab-only-b">Solicitar Cotización</span>
                </a>
            </div>

        </div>

        <!-- Banner Horizontal Enterprise Custom -->
        <div class="mt-10 rounded-3xl border border-primary/15 bg-gradient-to-r from-primary/[0.04] via-primary/[0.02] to-accent-brand/[0.04] p-8 sm:p-10 flex flex-col lg:flex-row items-center justify-between gap-6 relative overflow-hidden" data-aos="fade-up">
            <div class="flex-1 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary-vibrant text-xs font-semibold uppercase tracking-wider mb-3">
                    Solución a Medida
                </div>
                <h4 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">¿Tu empresa procesa más de 1.000 cheques por mes?</h4>
                <p class="mt-2 text-base text-primary/60 font-light max-w-2xl">
                    Armamos un plan a medida según el volumen de operaciones de tu negocio, con facturación institucional (Factura A o B) y atención directa.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto shrink-0">
                <a href="#contacto" data-plan="Enterprise a Medida" class="plan-trigger-btn flex h-12 items-center justify-center rounded-full bg-primary-vivid px-8 text-sm font-semibold text-white hover:bg-primary-vibrant shadow-sm hover:shadow transition-all duration-300">
                    Hablar con Ventas
                </a>
                <a href="/planes" class="flex h-12 items-center justify-center rounded-full border border-primary/20 px-6 text-sm font-medium text-primary hover:bg-primary/5 transition-all duration-300">
                    Ver Matriz Completa
                </a>
            </div>
        </div>

        <!-- Note & Risk Reversal -->
        <div class="mt-10 flex flex-col items-center justify-center text-center">
            <p class="ab-only-a text-sm text-primary/50 font-light">
                * Las consultas excedentes en cualquier plan se cobran con un <strong class="font-medium text-primary/70">10% de recargo</strong> sobre el costo base por cheque.
            </p>
            <div class="flex flex-wrap justify-center gap-6 sm:gap-10 mt-5">
                <span class="flex items-center gap-2 text-sm text-primary/60">
                    <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    Sin contratos de permanencia
                </span>
                <span class="flex items-center gap-2 text-sm text-primary/60">
                    <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    Factura A / B deducible
                </span>
                <span class="flex items-center gap-2 text-sm text-primary/60">
                    <svg class="h-4 w-4 text-accent-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    Renovación automática mensual
                </span>
            </div>
            
            <!-- Link to dedicated comparison page -->
            <div class="mt-8">
                <a href="/planes" class="inline-flex items-center gap-2 text-sm font-semibold text-primary-vibrant hover:text-primary transition-colors duration-300 group">
                    <span>Ver comparativa completa de funcionalidades y límites técnicos</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>
        </div>

        <!-- Individual Packs (Ultra-compact & Elegant Accessory Bar) -->
        <div data-aos="fade-up" class="mt-14 max-w-5xl mx-auto">
            <div class="rounded-2xl border border-primary/10 bg-white/60 backdrop-blur-md p-4 sm:p-5 shadow-[0_4px_20px_-10px_rgba(25,44,95,0.05)] flex flex-col lg:flex-row items-center justify-between gap-4 sm:gap-6">
                
                <!-- Left: Info & Context -->
                <div class="flex items-center gap-3 text-center sm:text-left flex-wrap sm:flex-nowrap justify-center sm:justify-start">
                    <span class="px-2.5 py-1 rounded-lg bg-primary/5 text-primary-vibrant text-xs font-semibold tracking-wide shrink-0">
                        Uso Ocasional
                    </span>
                    <p class="text-sm text-primary/70 font-light">
                        <strong class="font-semibold text-primary">Packs de créditos prepagos</strong> sin vencimiento.
                        <span class="ab-only-a text-xs text-primary/50 block sm:inline sm:ml-1">Desde $440 por cheque.</span>
                        <span class="ab-only-b text-xs text-primary/50 block sm:inline sm:ml-1">Consultá cuando lo necesites.</span>
                    </p>
                </div>

                <!-- Center: Compact Pack Pills -->
                <div class="flex items-center gap-2 flex-wrap justify-center">
                    <!-- Pack 10 -->
                    <div class="px-3 py-1.5 rounded-xl border border-primary/10 bg-white/80 text-center hover:border-primary/20 transition-all text-xs">
                        <span class="font-bold text-primary">10</span> <span class="text-primary/40 font-light">cons.</span>
                        <span class="ab-inline-a font-semibold text-accent ml-1.5">$5.000</span>
                    </div>
                    <!-- Pack 25 -->
                    <div class="px-3 py-1.5 rounded-xl border border-primary/10 bg-white/80 text-center hover:border-primary/20 transition-all text-xs">
                        <span class="font-bold text-primary">25</span> <span class="text-primary/40 font-light">cons.</span>
                        <span class="ab-inline-a font-semibold text-accent ml-1.5">$12.000</span>
                    </div>
                    <!-- Pack 50 -->
                    <div class="px-3 py-1.5 rounded-xl border border-primary/10 bg-white/80 text-center hover:border-primary/20 transition-all text-xs">
                        <span class="font-bold text-primary">50</span> <span class="text-primary/40 font-light">cons.</span>
                        <span class="ab-inline-a font-semibold text-accent ml-1.5">$23.000</span>
                    </div>
                    <!-- Pack 100 -->
                    <div class="px-3 py-1.5 rounded-xl border border-primary/10 bg-white/80 text-center hover:border-primary/20 transition-all text-xs">
                        <span class="font-bold text-primary">100</span> <span class="text-primary/40 font-light">cons.</span>
                        <span class="ab-inline-a font-semibold text-accent ml-1.5">$44.000</span>
                    </div>
                </div>

                <!-- Right: Compact CTA Button -->
                <a href="https://app.chequearapp.com.ar" class="shrink-0 flex h-10 items-center justify-center rounded-full bg-primary-vibrant/10 hover:bg-primary-vibrant text-primary-vibrant hover:text-white px-5 text-xs font-semibold transition-all duration-300 gap-1.5 border border-primary-vibrant/20">
                    <span>Cargar en la App</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>

            </div>
        </div>

    </div>
</section>
